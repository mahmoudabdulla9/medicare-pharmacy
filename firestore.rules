rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a signed-in user whose UID has a document in /admins.
    // Admin documents are created by hand in the Firebase console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function text(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function optionalText(value, max) {
      return value is string && value.size() <= max;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everyone can see visible products. Only admins can see hidden ones or change anything.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Shoppers (signed in anonymously) can place an order and read their own orders.
    // Only admins can read every order or change its status.
    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['uid', 'customer', 'items', 'subtotal', 'deliveryFee', 'total', 'status', 'stockDeducted', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.stockDeducted == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number
        && request.resource.data.deliveryFee is number
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.customer.keys().hasOnly(['name', 'email', 'phone', 'address', 'notes'])
        && text(request.resource.data.customer.name, 100)
        && text(request.resource.data.customer.email, 120)
        && text(request.resource.data.customer.phone, 30)
        && text(request.resource.data.customer.address, 300)
        && optionalText(request.resource.data.customer.notes, 500);
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Anyone can send a contact message. Only admins can read or delete messages.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && text(request.resource.data.name, 80)
        && text(request.resource.data.email, 120)
        && text(request.resource.data.message, 600)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
